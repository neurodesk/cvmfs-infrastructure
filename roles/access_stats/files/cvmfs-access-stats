def write_atomic(path, data):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


# ------------------------------------------------------------------- main --

def default_repo():
    repos = os.listdir("/etc/cvmfs/repositories.d") if os.path.isdir(
        "/etc/cvmfs/repositories.d") else []
    return repos[0] if len(repos) == 1 else None


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo", default=default_repo())
    ap.add_argument("--repo-dir", help="default: /srv/cvmfs/<repo>")
    ap.add_argument("--squid-log", default="/var/log/squid/access.log")
    ap.add_argument("--geo-db", default=GEO_DB)
    ap.add_argument("--state-dir", default="/var/lib/cvmfs-access-stats")
    ap.add_argument("--output-dir", default="/var/www/html/stats")
    ap.add_argument("--min-networks", type=int, default=3,
                    help="k-anonymity threshold per published group (default 3)")
    ap.add_argument("--retention-days", type=int, default=400,
                    help="keep salted network hashes this long (default 400)")
    ap.add_argument("--report-only", action="store_true")
    ap.add_argument("-q", "--quiet", action="store_true")
    args = ap.parse_args()
    if not args.repo:
        ap.error("--repo is required (more than one repository configured)")
    args.repo_dir = args.repo_dir or os.path.join("/srv/cvmfs", args.repo)
    if args.min_networks < 2:
        ap.error("--min-networks must be at least 2")

    def log(msg):
        if not args.quiet:
            print(time.strftime("%H:%M:%S"), msg, flush=True)

    os.umask(0o077)
    db = open_state(args.state_dir)
    if not args.report_only:
        secret = get_secret(args.state_dir)
        parse_logs(db, args, secret, log)
        purge(db, args.retention_days)
    stats = Report(db, args.min_networks).build(
        args.repo, os.uname().nodename, args.retention_days)
    os.makedirs(args.output_dir, mode=0o755, exist_ok=True)
    os.chmod(args.output_dir, 0o755)
    write_atomic(os.path.join(args.output_dir, "stats.json"),
                 json.dumps(stats, indent=1, ensure_ascii=False))
    write_atomic(os.path.join(args.output_dir, "index.html"), render_html(stats))
    log("report written to %s" % args.output_dir)


if __name__ == "__main__":
    main()
